# Environment variables must be loaded by your shell or Docker Compose.
DEBUG=0
# HTTPS is the default. HTTP is an explicit opt-in for trusted-network tests only.
DEPLOY_SCHEME=https
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://schedule.example.org
# compose.nginx.yaml adds nodecor.ru/www.nodecor.ru to DOMAIN and these optional lists.
# Keep the existing .env.nginx on the VPS; no regeneration is needed for domain aliases.
# Existing HTTP deployment example (do not enable HTTPS until a certificate is configured):
# DEPLOY_SCHEME=http
# ALLOWED_HOSTS=localhost,127.0.0.1,185.171.83.215,nodecor.ru,www.nodecor.ru
# CSRF_TRUSTED_ORIGINS=http://185.171.83.215:5555,http://nodecor.ru,http://www.nodecor.ru
TIME_ZONE=Europe/Moscow
# Omit DATABASE_URL to use local SQLite.
# DATABASE_URL=postgresql://schedule:password@localhost:5432/schedule
